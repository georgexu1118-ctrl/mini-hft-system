# Copy to .env and fill in values. Never commit .env to git.

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ── CORS (JSON array of allowed origins) ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: run postgres via docker-compose
DATABASE_URL=postgresql+asyncpg://hft:hft@localhost:5432/hft
PERSISTENCE_ENABLED=true
PERSISTENCE_BATCH_SIZE=250
PERSISTENCE_FLUSH_INTERVAL_MS=25
PERSISTENCE_MAX_RETRIES=3
PERSISTENCE_RETRY_BACKOFF_MS=20

# Supabase: replace with your project connection string
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Engine ───────────────────────────────────────────────────────────────────
# Select "cpp" only after building hft_engine_cpp locally.
MATCHING_BACKEND=python
EVENT_QUEUE_DEPTH=10000

# ── Market Data ──────────────────────────────────────────────────────────────
# Tick interval in milliseconds (100ms = 10 Hz)
MARKET_DATA_TICK_INTERVAL_MS=100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
